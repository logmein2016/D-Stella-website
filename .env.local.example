# Supabase project (Project Settings -> API).
# SUPABASE_URL/SUPABASE_ANON_KEY: read server-side only, by
# app/api/leads/route.ts. See design_handoff_ansuman_designs_site/README.md
# for the leads table schema and RLS policy this depends on.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Same project/key, exposed to the browser for the /admin area (login, leads
# dashboard, photo uploads). Run the SQL files in supabase/migrations/ first.
# Usually the same values as above.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: protects app/api/cron/keepalive from being triggered by anyone
# who finds the URL. If set, Vercel automatically sends it as a Bearer token
# on the scheduled request (see vercel.json) — generate any random string and
# set the same value in Vercel → Project → Settings → Environment Variables.
CRON_SECRET=
