# Supabase project (Project Settings -> API). These are read server-side only,
# by app/api/leads/route.ts — never exposed to the client bundle.
# See design_handoff_ansuman_designs_site/README.md for the leads table schema
# and RLS policy this depends on.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# WhatsApp number leads fall back to, and that the footer/nav display.
# Digits only, with country code, no leading +. Placeholder until the client
# supplies their real number.
NEXT_PUBLIC_WHATSAPP_NUMBER=919000000000
